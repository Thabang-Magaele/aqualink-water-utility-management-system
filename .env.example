# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app.
# These web config values are NOT secrets; they identify your project.
# Real security comes from Firestore rules and Cloud Functions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to the local Firebase Emulator Suite instead of the cloud project.
VITE_USE_EMULATORS=false

# Optional. Base URL of the `api` Cloud Function. Leave empty to use the default
# https://us-central1-<project-id>.cloudfunctions.net/api (or the emulator when VITE_USE_EMULATORS=true).
VITE_API_BASE_URL=
