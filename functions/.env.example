# Copy to functions/.env before deploying.
# Firestore triggers must run in the same region as your Firestore database.
# Find it in the Firebase console: Firestore Database → the location shown at the top
# (or Project settings → General → "Default GCP resource location").
#   nam5 (United States multi-region) → us-central1
#   eur3 (Europe multi-region)        → europe-west1
#   a single region, e.g. africa-south1 → the same value
FIRESTORE_REGION=us-central1
