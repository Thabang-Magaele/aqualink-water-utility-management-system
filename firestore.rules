rules_version = '2';

// PHASE 0: everything is locked. No client can read or write any document.
// Role-based rules are written in Phase 2 and Phase 5.
// Never replace this with `allow read, write: if true;`
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
